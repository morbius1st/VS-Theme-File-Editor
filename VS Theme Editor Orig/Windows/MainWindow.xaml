<ui:FluentWindow
		x:Class="VS_Theme_Editor_Orig.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="clr-namespace:VS_Theme_Editor_Orig"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		Title="VS 2022 Theme Editor"
		Width="1300"
		Height="900"
		mc:Ignorable="d"
		d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
		d:Background="Black"
		ExtendsContentIntoTitleBar="True"
		WindowBackdropType="Mica"
		Loaded="FluentWindow_Loaded"
		>

	<ui:FluentWindow.Resources>
		<local:StringToColorConverter x:Key="StringToColorConverter" />

		<DrawingBrush x:Key="CheckerBrush"
				TileMode="Tile"
				Viewport="0,0,10,10"
				ViewportUnits="Absolute"
				>
			<DrawingBrush.Drawing>
				<DrawingGroup>
					<!--  Background white square  -->
					<GeometryDrawing Brush="White">
						<GeometryDrawing.Geometry>
							<RectangleGeometry Rect="0,0,10,10" />
						</GeometryDrawing.Geometry>
					</GeometryDrawing>

					<!--  Top-left black square  -->
					<GeometryDrawing Brush="#CCCCCC">
						<GeometryDrawing.Geometry>
							<RectangleGeometry Rect="0,0,5,5" />
						</GeometryDrawing.Geometry>
					</GeometryDrawing>

					<!--  Bottom-right black square  -->
					<GeometryDrawing Brush="#CCCCCC">
						<GeometryDrawing.Geometry>
							<RectangleGeometry Rect="5,5,5,5" />
						</GeometryDrawing.Geometry>
					</GeometryDrawing>
				</DrawingGroup>
			</DrawingBrush.Drawing>
		</DrawingBrush>

	</ui:FluentWindow.Resources>

	<Grid Margin="10,0,10,10">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="auto" />
		</Grid.RowDefinitions>

		<ContentPresenter x:Name="RootContentDialog"
				Grid.Row="1"
				Grid.RowSpan="4"
				Margin="-10,9,10,-9"
				Panel.ZIndex="3"
				/>

		<ui:TitleBar
				Title="VS Theme File Editor Orig"
				Grid.Row="0"
				Margin="0,4,-5,-5"
				Padding="0"
				VerticalContentAlignment="Top"
				Panel.ZIndex="2"
				FontSize="14"
				/>

		<Menu
				Grid.Row="1"
				Margin="-5,-5,0,5"
				Padding="0"
				>

			<MenuItem
					d:Foreground="White"
					Command="{Binding SelectThemeCommand}"
					Header="_Open..."
					InputGestureText="O"
					>
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Document32" />
				</MenuItem.Icon>
			</MenuItem>

			<MenuItem
					d:Foreground="White"
					Command="{Binding SaveThemeCommand}"
					Header="_Save"
					InputGestureText="S"
					>
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Save16" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem
					d:Foreground="White"
					Command="{Binding SaveAsThemeCommand}"
					Header="S_ave As..."
					InputGestureText="A"
					>
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="SaveMultiple16" />
				</MenuItem.Icon>
			</MenuItem>
			<Separator />
			<MenuItem
					d:Foreground="White"
					Command="{Binding TestThemeCommand}"
					Header="_Test in Visual Studio..."
					InputGestureText="T"
					>
				<MenuItem.Icon>
					<ui:SymbolIcon Symbol="Run16" />
				</MenuItem.Icon>
			</MenuItem>
		</Menu>

		<ui:Card
				Grid.Row="2"
				Grid.Column="0"
				>

			<Grid VerticalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="100" />
					<ColumnDefinition Width="330" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="100" />
					<ColumnDefinition Width="*" />

				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="24" />
					<RowDefinition Height="110" />

				</Grid.RowDefinitions>

				<Label
						Grid.Row="0"
						Grid.Column="0"
						Content="Recent Files"
						/>

				<DockPanel
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						>

					<Label
							Content="No Recent Files"
							Foreground="Gray"
							>
						<Label.Style>
							<Style TargetType="Label">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Value="True" Binding="{Binding MruMgr.FilesView.IsEmpty}">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Label.Style>
					</Label>

					<ui:ListView x:Name="MruFiles"
							Margin="10,0,0,0"
							d:ItemsSource="{d:SampleData}"
							SelectedItem="{Binding MruFile,
																		 Mode=TwoWay}"
							VirtualizingPanel.ScrollUnit="Pixel"
							SelectionMode="Single"
							ItemsSource="{Binding MruMgr.FilesView,
																		Mode=OneWay}"
							>
						<ui:ListView.Style>
							<Style
									TargetType="ui:ListView"
									BasedOn="{StaticResource {x:Type ui:ListView}}"
									>
								<Setter Property="Visibility" Value="Visible" />
								<Style.Triggers>
									<DataTrigger Value="True" Binding="{Binding MruMgr.FilesView.IsEmpty}">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ui:ListView.Style>

						<ui:ListView.ItemTemplate>
							<DataTemplate DataType="{x:Type local:MostRecentlyUsed}">
								<DockPanel>

									<ui:TextBlock
											Margin="0,0,15,0"
											Width="200"
											DockPanel.Dock="Left"
											Text="{Binding Path=ThemeName,
																		 FallbackValue='Theme Name'}"
											ToolTip="{Binding Path=FolderPath,
																				FallbackValue='Folder Path'}"
											/>

									<ui:TextBlock
											DockPanel.Dock="Left"
											Text="{Binding Path=FileName,
																		 FallbackValue='File Name.ext'}"
											ToolTip="{Binding Path=FolderPath,
																				FallbackValue='Folder Path'}"
											/>
									<!--  StringFormat='&#x3E;{0}&#x3C;',  -->


								</DockPanel>
							</DataTemplate>
						</ui:ListView.ItemTemplate>

					</ui:ListView>

				</DockPanel>

				<Label
						Grid.Row="0"
						Grid.Column="3"
						Content="Recent Folders"
						/>

				<ui:ListView x:Name="MruFolders"
						Grid.Row="1"
						Grid.Column="3"
						Grid.ColumnSpan="2"
						Margin="10,0,0,0"
						d:ItemsSource="{d:SampleData}"
						SelectedItem="{Binding MruFolder,
																	 Mode=TwoWay}"
						VirtualizingPanel.ScrollUnit="Pixel"
						ItemsSource="{Binding MruMgr.FoldersView,
																	Mode=OneWay}"
						>
					<ui:ListView.ItemTemplate>
						<DataTemplate DataType="{x:Type local:MostRecentlyUsed}">
							<ui:TextBlock Text="{Binding Path=FolderPath, FallbackValue='Folder Path'}" />
						</DataTemplate>
					</ui:ListView.ItemTemplate>

				</ui:ListView>

			</Grid>

		</ui:Card>

		<ui:Card
				Grid.Row="3"
				BorderThickness="0,1,0,0"
				BorderBrush="White"
				>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="450" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="320" />
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />

				</Grid.RowDefinitions>

				<Label
						Grid.Row="0"
						Grid.Column="0"
						Content="Theme Details"
						VerticalAlignment="Center"
						/>

				<!--  name  -->
				<StackPanel
						Grid.Row="1"
						Grid.Column="0"
						Orientation="Horizontal"
						>
					<TextBlock
							Width="100"
							VerticalAlignment="Center"
							Text="Theme Name "
							/>

					<ui:TextBox
							Margin="5,5"
							Width="320"
							Text="{Binding WorkingTheme.Name,
														 Mode=TwoWay,
														 UpdateSourceTrigger=LostFocus}"
							/>
				</StackPanel>

				<!--  guid  -->
				<StackPanel
						Grid.Row="2"
						Grid.Column="0"
						Orientation="Horizontal"
						>
					<TextBlock
							Width="100"
							VerticalAlignment="Center"
							Text="Guid "
							/>
					<ui:TextBox
							Margin="5,5"
							Width="320"
							IsReadOnly="True"
							Text="{Binding WorkingTheme.Guid}"
							/>

					<Button
							Margin="-40,2,0,0"
							Width="36"
							Height="36"
							Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Command="{Binding RegenerateGuidCommand}"
							>
						<ui:SymbolIcon
								FontSize="16"
								Symbol="ArrowRotateClockwise24"
								/>
						<Button.ToolTip>
							<ToolTip>
								<TextBlock Text="Regenerate Guid" />
							</ToolTip>
						</Button.ToolTip>
					</Button>
				</StackPanel>

				<!--  slug  -->
				<StackPanel
						Grid.Row="1"
						Grid.Column="1"
						Orientation="Horizontal"
						>
					<TextBlock
							Width="100"
							VerticalAlignment="Center"
							Text="Theme Slug "
							/>
					<ui:TextBox
							Margin="5,5"
							Width="320"
							Text="{Binding WorkingTheme.Slug,
														 Mode=TwoWay,
														 UpdateSourceTrigger=LostFocus}"
							/>
				</StackPanel>

				<!--  fallback guid  -->
				<StackPanel
						Grid.Row="2"
						Grid.Column="1"
						Orientation="Horizontal"
						>
					<TextBlock
							Width="100"
							VerticalAlignment="Center"
							Text="Fallback Guid "
							/>
					<ui:TextBox
							Margin="5,5"
							Width="320"
							Text="{Binding WorkingTheme.Fallback,
														 Mode=TwoWay,
														 UpdateSourceTrigger=LostFocus}"
							/>
				</StackPanel>

				<!--  search  -->
				<StackPanel
						Grid.Row="2"
						Grid.Column="2"
						Margin="0,0,10,8"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Orientation="Horizontal"
						>
					<TextBlock
							Margin="0,0,8,0"
							Width="75"
							VerticalAlignment="Center"
							TextAlignment="Right"
							Text="Search"
							/>
					<ui:TextBox
							Width="230"
							Text="{Binding ColorFilter,
														 UpdateSourceTrigger=PropertyChanged}"
							/>
				</StackPanel>

				<StackPanel
						Grid.Row="1"
						Grid.Column="2"
						Orientation="Horizontal"
						>
					<Label
							Content="Theme Style"
							Width="80"
							VerticalAlignment="Center"
							Padding="0,0,4,0"
							HorizontalAlignment="Right"
							/>
					<ui:DropDownButton x:Name="DdbThemeStyle"
							Content="{Binding Path=ThemeInfo.Style,
																FallbackValue='Light'}"
							Margin="5,5"
							Width="230"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							HorizontalContentAlignment="Stretch"
							DockPanel.Dock="Top"
							>

						<ui:DropDownButton.Flyout>
							<ContextMenu>
								<MenuItem x:Name="MnuLight"
										Header="Light"
										Command="{Binding ChooseBaseThemeCommand}"
										CommandParameter="Light"
										/>
								<MenuItem x:Name="MnuDark"
										Header="Dark"
										Command="{Binding ChooseBaseThemeCommand}"
										CommandParameter="Dark"
										>

								</MenuItem>
							</ContextMenu>
						</ui:DropDownButton.Flyout>

					</ui:DropDownButton>

				</StackPanel>


				<!--  VS version  -->
				<StackPanel
						Grid.Row="0"
						Grid.Column="2"
						Margin="0,0,10,8"
						HorizontalAlignment="Right"
						VerticalAlignment="Bottom"
						Orientation="Horizontal"
						>
					<TextBlock
							Margin="0,0,8,0"
							Width="75"
							Padding="0,6,0,9"
							VerticalAlignment="Center"
							TextAlignment="Right"
							Text="VS Version"
							/>

					<Border
							Margin="0,6,-20,6"
							Width="5"
							Background="{Binding VisualStudioDescBdr,
																	 FallbackValue='blue'}"
							CornerRadius="3"
							/>

					<ui:TextBox
							Width="230"
							Padding="18,7,10,8"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Text="{Binding VisualStudioDesc,
														 FallbackValue='Visual Studio 2022 Community',
														 Mode=OneWay}"
							>


					</ui:TextBox>
				</StackPanel>


			</Grid>

		</ui:Card>

		<ui:Card
				Grid.Row="4"
				VerticalAlignment="Stretch"
				VerticalContentAlignment="Stretch"
				>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
							Width="300"
							MinWidth="300"
							/>
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<ui:ListView x:Name="WorkingThemeCategories"
						Margin="5,0"
						d:ItemsSource="{d:SampleData}"
						SelectedItem="{Binding SelectedCategory,
																	 Mode=TwoWay}"
						VirtualizingPanel.ScrollUnit="Pixel"
						ItemsSource="{Binding WorkingTheme.Categories}"
						>
					<ui:ListView.ItemTemplate>
						<DataTemplate>
							<TextBlock
									Margin="5"
									Text="{Binding Name}"
									/>
						</DataTemplate>
					</ui:ListView.ItemTemplate>
					<ui:ListView.ContextMenu>
						<ContextMenu>
							<MenuItem
									CommandParameter="{Binding ElementName=WorkingThemeCategories,
																						 Path=SelectedItem}"
									Header="_Add New Category"
									InputGestureText="A"
									Click="btn_AddCategory_clicked"
									>
								<MenuItem.Icon>
									<ui:SymbolIcon Symbol="Add12" />
								</MenuItem.Icon>
							</MenuItem>

							<Separator />
							<MenuItem
									Foreground="#d70000"
									Command="{Binding DeleteCategoryCommand}"
									CommandParameter="{Binding PlacementTarget.SelectedItem,
																						 RelativeSource={RelativeSource AncestorType=ContextMenu}}"
									Header="Delete Category"
									InputGestureText="Del"
									>
								<MenuItem.Icon>
									<ui:SymbolIcon
											Foreground="#d70000"
											Symbol="Delete12"
											/>
								</MenuItem.Icon>
							</MenuItem>
						</ContextMenu>
					</ui:ListView.ContextMenu>
				</ui:ListView>
				<GridSplitter
						Width="3"
						Background="#20FFFFFF"
						/>

				<ui:DataGrid
						Grid.Column="1"
						d:ItemsSource="{d:SampleData}"
						AutoGenerateColumns="False"
						CanUserAddRows="True"
						CanUserDeleteRows="True"
						VirtualizingPanel.ScrollUnit="Pixel"
						ItemsSource="{Binding FilteredEntries}"
						>
					<ui:DataGrid.Columns>
						<DataGridTextColumn
								Binding="{Binding Source}"
								Header="Source"
								/>
						<DataGridTextColumn
								Binding="{Binding Name}"
								Header="Name"
								Width="200"
								/>
						<!--<DataGridTextColumn Binding="{Binding BackgroundType}" Header="Background Type" />-->
						<!--  Background Preview  -->
						<DataGridTemplateColumn
								Width="200"
								Header="Background"
								>
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<Grid>
											<Rectangle
													Width="32"
													Height="16"
													Fill="{StaticResource CheckerBrush}"
													Stroke="Black"
													StrokeThickness="0.5"
													/>
											<Rectangle
													Width="32"
													Height="16"
													Stroke="Black"
													StrokeThickness="0.5"
													>
												<Rectangle.Fill>
													<SolidColorBrush Color="{Binding Background, Converter={StaticResource StringToColorConverter}}" />
												</Rectangle.Fill>
											</Rectangle>
										</Grid>

										<ui:TextBox
												Margin="5,0"
												Width="110"
												Text="{Binding Background,
																			 Mode=TwoWay,
																			 UpdateSourceTrigger=PropertyChanged}"
												PlaceholderText="#"
												/>
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<!--<DataGridTextColumn Binding="{Binding ForegroundType}" Header="Foreground Type" />-->
						<!--  Foreground Preview  -->
						<DataGridTemplateColumn
								Width="200"
								Header="Foreground"
								>
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<Grid>
											<Rectangle
													Width="32"
													Height="16"
													Fill="{StaticResource CheckerBrush}"
													Stroke="Black"
													StrokeThickness="0.5"
													/>
											<Rectangle
													Width="32"
													Height="16"
													Stroke="Black"
													StrokeThickness="0.5"
													>
												<Rectangle.Fill>
													<SolidColorBrush Color="{Binding Foreground, Converter={StaticResource StringToColorConverter}}" />
												</Rectangle.Fill>
											</Rectangle>
										</Grid>
										<ui:TextBox
												Margin="5,0"
												Width="110"
												Text="{Binding Foreground,
																			 Mode=TwoWay,
																			 UpdateSourceTrigger=LostFocus}"
												PlaceholderText="#"
												/>
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</ui:DataGrid.Columns>
				</ui:DataGrid>

			</Grid>

		</ui:Card>

		<ui:SnackbarPresenter x:Name="RootSnackbar"
				Grid.Row="1"
				Grid.RowSpan="4"
				MaxWidth="600"
				/>

	</Grid>

</ui:FluentWindow>
