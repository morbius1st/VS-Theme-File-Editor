<ResourceDictionary
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		>


	<SolidColorBrush x:Key="ScrollBar.Static.Background" Color="{DynamicResource  ControlFillColorDefault}" />
	<SolidColorBrush x:Key="ScrollBar.Static.Border" Color="Red" />

	<SolidColorBrush x:Key="ScrollBar.Thumb.Static" Color="#777777" />
	<SolidColorBrush x:Key="ScrollBar.Thumb.MouseOver" Color="#AAAAAA" />
	<SolidColorBrush x:Key="ScrollBar.Thumb.Pressed" Color="#CCCCCC" />

	<SolidColorBrush x:Key="ScrollBar.Glyph.Static" Color="RoyalBlue" />
	<SolidColorBrush x:Key="ScrollBar.Glyph.Pressed" Color="#FFFF0000" />
	<SolidColorBrush x:Key="ScrollBar.Glyph.MouseOver" Color="DeepSkyBlue" />
	<SolidColorBrush x:Key="ScrollBar.Glyph.Disabled" Color="#FFff0000" />

	<SolidColorBrush x:Key="ScrollViewer.Corner.Static.Background" Color="{DynamicResource ControlFillColorDefault}"/>

</ResourceDictionary>