<ui:FluentWindow
		x:Class="VS_Theme_Editor.WinThemeReport"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:VS_Theme_Editor"
		xmlns:shsup="clr-namespace:SharedWPF.ShSupport"
		xmlns:sys="clr-namespace:System;assembly=System.Runtime"
		xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
		Title="Theme Report"
		Width="800"
		Height="550"
		MinWidth="300"
		MinHeight="300"
		mc:Ignorable="d"
		d:DataContext="{d:DesignInstance local:WinThemeReportViewModel}"
		d:Background="Black"
		>
	<ui:FluentWindow.Resources>
		<ResourceDictionary>

			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Support/CsScrollBar.xaml" />
				<ResourceDictionary Source="Support/CsScrollViewer.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<sys:Int32 x:Key="Zero">0</sys:Int32>
			<sys:Int32 x:Key="One">1</sys:Int32>
			<sys:Int32 x:Key="Two">1</sys:Int32>
			<sys:Int32 x:Key="Nine">9</sys:Int32>

			<sys:Boolean x:Key="True">true</sys:Boolean>
			<sys:Boolean x:Key="False">false</sys:Boolean>

			

		</ResourceDictionary>
	</ui:FluentWindow.Resources>

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="120" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="40" />
			<RowDefinition Height="40" />
			<RowDefinition Height="8"/>
			<RowDefinition Height="*" />
			<RowDefinition Height="50" />
		</Grid.RowDefinitions>

		<ui:ContentDialogHost x:Name="RootContentDialog"
				Grid.Row="0"
				Grid.Column="0"
				Grid.RowSpan="2"
				Panel.ZIndex="3"
				/>

		<ui:TitleBar
				Title="VS Theme File Editor"
				Grid.Row="0"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="5,0,0,0"
				Height="34"
				Padding="0"
				VerticalContentAlignment="Top"
				Panel.ZIndex="2"
				FontSize="14"
				/>

		<ProgressBar Grid.Column="0"
				Grid.Row="2"
				Grid.ColumnSpan="2"
				Margin="10,0,25,0"
				Value="{Binding ProgressValue}"
				Minimum="0"
				Maximum="{Binding ProgressMaximum}"
				/>

		<DockPanel
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="10,0,20,0"
				VerticalAlignment="Top"
				>

			<ui:TextBlock
					VerticalAlignment="Center"
					d:Foreground="white"
					DockPanel.Dock="Left"
					Text="Report Type"
					/>

			<ui:DropDownButton
					Content="{Binding ReportType,
														FallbackValue='Basic'}"
					Margin="10,0,0,0"
					Width="140"
					HorizontalContentAlignment="Stretch"
					VerticalContentAlignment="Center"
					FontFamily="Segoe UI Symbol"
					FontSize="14"
					IsEnabled="True"
					>

				<ui:DropDownButton.Flyout>
					<ContextMenu x:Name="CtxWhich">
						<ui:MenuItem x:Name="MnuBasicType"
								Tag="{StaticResource Zero}"
								Header="Basic"
								CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								Command="{Binding SetWhichReportCommand}"
								/>
						<ui:MenuItem
								Tag="{StaticResource One}"
								Header="Enhanced"
								CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								Command="{Binding SetWhichReportCommand}"
								/>
						<ui:MenuItem
								Tag="{StaticResource Two}"
								Header="Advanced"
								CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								Command="{Binding SetWhichReportCommand}"
								/>
						<ui:MenuItem
								Tag="{StaticResource Nine}"
								Header="Complete"
								CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								Command="{Binding SetWhichReportCommand}"
								/>

					</ContextMenu>
				</ui:DropDownButton.Flyout>

			</ui:DropDownButton>

			<ui:TextBlock
					Margin="30,0,0,0"
					VerticalAlignment="Center"
					d:Foreground="white"
					DockPanel.Dock="Left"
					Text="Output Type"
					/>

			<ui:DropDownButton
					Content="{Binding VerboseType,
														FallbackValue='Basic'}"
					Margin="10,0,0,0"
					Width="140"
					HorizontalContentAlignment="Stretch"
					VerticalContentAlignment="Center"
					FontFamily="Segoe UI Symbol"
					FontSize="14"
					IsEnabled="True"
					>
				<!--  Icon="{ui:FontIcon Glyph='⓿', FontFamily='Segoe UI'}"  -->
				<ui:DropDownButton.Flyout>
					<ContextMenu>
						<ui:MenuItem x:Name="MnuBasicVerbose"
								Tag="{StaticResource False}"
								Header="Basic"
								Command="{Binding SetVerboseReportCommand}"
								CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								/>
						<ui:MenuItem
								Tag="{StaticResource True}"
								Header="Verbose"
								Command="{Binding SetVerboseReportCommand}"
								CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								/>

					</ContextMenu>
				</ui:DropDownButton.Flyout>
			</ui:DropDownButton>

			<ui:Button
					Content="Proceed"
					Width="100"
					HorizontalAlignment="Right"
					DockPanel.Dock="Right"
					Command="{Binding ProceedCommand}"
					/>

		</DockPanel>

		<ui:TextBox x:Name="TbxReport"
				Grid.Row="3"
				Grid.Column="0"
				Grid.RowSpan="2"
				Grid.ColumnSpan="2"
				Margin="10,5,10,10"
				Padding="3"
				FontFamily="MS Gothic"
				FontSize="14"
				Background="{DynamicResource TextControlBackground}"
				Foreground="{DynamicResource TextFillColorPrimaryBrush}"
				BorderThickness="0"
				d:Foreground="White"
				d:Background="Black"
				d:Text="testing 1,2,3,4"
				Text="{Binding Path=ReportText}"
				AcceptsReturn="True"
				HorizontalScrollBarVisibility="Visible"
				VerticalScrollBarVisibility="Visible"
				Style="{x:Null}"
				>

			<!--  Text="{Binding Path=ReportText  -->
			<!--  , FallbackValue='hello hello hello hello hello hello hello hello hello hello  hello hello hello hello hello  hello hello hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello&#013;hello hello'}"  -->

			<ui:TextBox.Resources>
				<Style TargetType="{x:Type ScrollViewer}">
					<Setter Property="Template" Value="{StaticResource CsScrollViewerCt}" />
					<Setter Property="shsup:CsScrollBarAp.ScrollBarWidth" Value="8" />
					<Setter Property="shsup:CsScrollBarAp.TrackWidth" Value="4" />
					<Setter Property="shsup:CsScrollBarAp.ThumbCornerRadius" Value="4" />
					<Setter Property="shsup:CsScrollBarAp.RepeatButtonIconGirth" Value="6" />
					<Setter Property="shsup:CsScrollBarAp.RepeatButtonLength" Value="16" />
					<Setter Property="shsup:CsScrollBarAp.RepeatButtonIconLength" Value="12" />


					<Setter Property="shsup:CsScrollBarAp.VertBorderColor" Value="{DynamicResource ScrollBar.Static.Border}" />
					<Setter Property="shsup:CsScrollBarAp.VertBorderThickness" Value="1,0,0,0" />
					<Setter Property="shsup:CsScrollBarAp.VerticalCornerRadius" Value="5" />

					<Setter Property="shsup:CsScrollBarAp.HorizBorderColor" Value="{DynamicResource ScrollBar.Static.Border}" />
					<Setter Property="shsup:CsScrollBarAp.HorizBorderThickness" Value="0,1,0,0" />
					<Setter Property="shsup:CsScrollBarAp.HorizontalCornerRadius" Value="5" />

					<Setter Property="shsup:CsScrollBarAp.IconMarginTopEnd" Value="0,2,0,1" />
					<Setter Property="shsup:CsScrollBarAp.IconMarginBottomEnd" Value="0,1,0,2" />

					<Setter Property="shsup:CsScrollBarAp.IconMarginLeftEnd" Value="2,0,1,0" />
					<Setter Property="shsup:CsScrollBarAp.IconMarginRightEnd" Value="1,0,2,0" />

					<Setter Property="shsup:CsScrollViewerAp.CornerRectBkgBrush" Value="{DynamicResource ScrollViewer.Corner.Static.Background}" />

					<!-- <Setter Property="shsup:CsScrollViewerAp.CornerRect1BdrBrush" Value="red" /> -->
					<!-- <Setter Property="shsup:CsScrollViewerAp.CornerRect1BdrThickness" Value="0.5" /> -->
					<!-- <Setter Property="shsup:CsScrollViewerAp.CornerRect1BdrRadius" Value="3" /> -->

					<!-- <Setter Property="shsup:CsScrollViewerAp.ContentPresenterBorderColor" Value="red" /> -->
					<!-- <Setter Property="shsup:CsScrollViewerAp.ContentPresenterBorderThickness" Value="0.5" /> -->
					<!-- <Setter Property="shsup:CsScrollViewerAp.ContentPresenterCornerRadius" Value="3" /> -->

				</Style>
			</ui:TextBox.Resources>

		</ui:TextBox>

		<Button x:Name="BtnClear"
				Grid.Row="3"
				Grid.Column="1"
				Content=""
				Margin="0,5,30,0"
				Width="30"
				Padding="0,2,0,6"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				HorizontalContentAlignment="Center"
				FontSize="20"
				FontFamily="Segoe UI Symbol"
				Background="Transparent"
				BorderThickness="0"
				IsEnabled="{Binding CanReset}"
				Command="{Binding ResetCommand}"
				/>

		<Button
				Grid.Row="4"
				Grid.Column="1"
				Content="Exit"
				Margin="0,0,20,20"
				Width="70"
				Padding="0,2,0,6"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				FontSize="20"
				Background="Transparent"
				BorderThickness="0"
				Click="Exit_Click"
				/>

	</Grid>

</ui:FluentWindow>
