							Grid.RowSpan="3"
							FontSize="12"
							d:Foreground="White"
							Text="{Binding ElementName=HueSlider,
														 Path=Value,
														 StringFormat={}{0:F1}}"
							Style="{StaticResource TbxCvDec}"
							/>

					<ui:Button
							Grid.Row="0"
							Grid.Column="0"
							Command="{x:Static Slider.IncreaseLarge}"
							CommandTarget="{Binding ElementName=HueSlider}"
							Style="{StaticResource BtnUpArrow}"
							/>

					<ui:Button
							Grid.Row="2"
							Grid.Column="0"
							Command="{x:Static Slider.DecreaseLarge}"
							CommandTarget="{Binding ElementName=HueSlider}"
							Style="{StaticResource BtnDnArrow}"
							/>

				</Grid>

				<!--  <ui:TextBox  -->
				<!--  d:Foreground="White"  -->
				<!--  Text="ff"  -->
				<!--  Style="{StaticResource TbxCvHex}"  -->
				<!--  />  -->

			</DockPanel>

			<!--  red end  -->


			<!--  green start  -->

			<ui:TextBlock
					Grid.Row="0"
					Grid.Column="12"
					FontTypography="Caption"
					d:Foreground="White"
					Text="S"
					Style="{StaticResource TblkCaptionTitle}"
					/>

			<Grid
					Grid.Row="1"
					Grid.Column="12"
					Width="26"
					HorizontalAlignment="Center"
					>

				<Rectangle
						Width="14"
						Style="{StaticResource RectVertColorBar}"
						>
					<Rectangle.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Offset="0.05" Color="{Binding SatOne.ColorValue, FallbackValue=#FFFF0000}" />
							<GradientStop Offset="0.95" Color="{Binding SatZero.ColorValue, FallbackValue=#FF808080}" />
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>


				<Slider x:Name="SaturationSlider"
						Value="{Binding SaturationValue}"
						d:Value="0.5"
						d:Foreground="blue"
						Style="{StaticResource SliderHslTo1}"
						/>

			</Grid>

			<DockPanel
					Grid.Row="3"
					Grid.Column="12"
					Style="{StaticResource DpColorNumbers}"
					>

				<Grid
						DockPanel.Dock="Top"
						Style="{StaticResource GrdNumberButton}"
						>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="{StaticResource GlUpArrow}" />
						<RowDefinition Height="{StaticResource GlTbxCvDec}" />
						<RowDefinition Height="{StaticResource GlDnArrow}" />
					</Grid.RowDefinitions>

					<ui:TextBox
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="3"
							Margin="-2,0,-3,0"
							FontSize="12"
							d:Foreground="White"
							Text="{Binding ElementName=SaturationSlider,
														 Path=Value,
														 StringFormat={}{0:F3}}"
							Style="{StaticResource TbxCvDec}"
							/>

					<ui:Button
							Grid.Row="0"
							Grid.Column="0"
							Command="{x:Static Slider.IncreaseLarge}"
							CommandTarget="{Binding ElementName=SaturationSlider}"
							Style="{StaticResource BtnUpArrow}"
							/>

					<ui:Button
							Grid.Row="2"
							Grid.Column="0"
							Command="{x:Static Slider.DecreaseLarge}"
							CommandTarget="{Binding ElementName=SaturationSlider}"
							Style="{StaticResource BtnDnArrow}"
							/>

				</Grid>

				<!--  <ui:TextBox  -->
				<!--  d:Foreground="White"  -->
				<!--  Text="ff"  -->
				<!--  Style="{StaticResource TbxCvHex}"  -->
				<!--  />  -->

			</DockPanel>

			<!--  green end  -->


			<!--  blue start  -->

			<ui:TextBlock
					Grid.Row="0"
					Grid.Column="14"
					FontTypography="Caption"
					d:Foreground="White"
					Text="L"
					Style="{StaticResource TblkCaptionTitle}"
					/>

			<Grid
					Grid.Row="1"
					Grid.Column="14"
					Width="26"
					HorizontalAlignment="Center"
					>

				<Rectangle
						Width="14"
						Style="{StaticResource RectVertColorBar}"
						>
					<Rectangle.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Offset="0.05" Color="{Binding LightOne.ColorValue, FallbackValue=#FFffffff}" />
							<GradientStop Offset="0.50" Color="{Binding LightHalf.ColorValue, FallbackValue=#FFFF0000}" />
							<GradientStop Offset="0.95" Color="{Binding LighZero.ColorValue, FallbackValue=#FF000000}" />
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>


				<Slider x:Name="LightnessSlider"
						Value="{Binding LightnessValue}"
						d:Value="0.5"
						d:Foreground="blue"
						Style="{StaticResource SliderHslTo1}"
						/>

			</Grid>

			<DockPanel
					Grid.Row="3"
					Grid.Column="14"
					Style="{StaticResource DpColorNumbers}"
					>

				<Grid
						DockPanel.Dock="Top"
						Style="{StaticResource GrdNumberButton}"
						>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Grid.RowDefinitions>
						<RowDefinition Height="{StaticResource GlUpArrow}" />
						<RowDefinition Height="{StaticResource GlTbxCvDec}" />
						<RowDefinition Height="{StaticResource GlDnArrow}" />
					</Grid.RowDefinitions>

					<ui:TextBox
							Grid.Row="0"
							Grid.Column="0"
							Grid.RowSpan="3"
							Margin="-2,0,-3,0"
							FontSize="12"
							d:Foreground="White"
							Text="{Binding ElementName=LightnessSlider,
														 Path=Value,
														 StringFormat={}{0:F3}}"
							Style="{StaticResource TbxCvDec}"
							/>

					<ui:Button
							Grid.Row="0"
							Grid.Column="0"
							Command="{x:Static Slider.IncreaseLarge}"
							CommandTarget="{Binding ElementName=LightnessSlider}"
							Style="{StaticResource BtnUpArrow}"
							/>

					<ui:Button
							Grid.Row="2"
							Grid.Column="0"
							Command="{x:Static Slider.DecreaseLarge}"
							CommandTarget="{Binding ElementName=LightnessSlider}"
							Style="{StaticResource BtnDnArrow}"
							/>

				</Grid>

				<!--  <ui:TextBox  -->
				<!--  d:Foreground="White"  -->
				<!--  Text="ff"  -->
				<!--  Style="{StaticResource TbxCvHex}"  -->
				<!--  />  -->

			</DockPanel>

			<!--  blue end  -->

			<ui:Button
					Grid.Row="5"
					Grid.Column="12"
					Grid.RowSpan="2"
					Grid.ColumnSpan="3"
					Content="Done"
					Margin="0,2,0,6"
					Height="32"
					Padding="0,0,0,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Bottom"
					FontSize="16"
					d:Foreground="White"
					Click="Done_OnClick"
					/>

		</Grid>

	</Grid>

</ui:FluentWindow>



