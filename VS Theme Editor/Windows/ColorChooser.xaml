		<Style x:Key="SliderThumb"
				TargetType="Thumb"
				>
			<Setter Property="SnapsToDevicePixels" Value="true" />
			<Setter Property="OverridesDefaultStyle" Value="true" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">

						<Path x:Name="Path"
								Data="F1 M 5.15625 14.589844 L 10 7.578125 L 14.853516 14.589844 L 10 21.582031 Z "
								Stretch="Uniform"
								RenderTransformOrigin="0.5,0.5"
								>
							<!--  Fill="{TemplateBinding Foreground}"  -->
							<Path.Style>
								<Style TargetType="Path">
									<Setter Property="Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" />
									<Style.Triggers>
										<DataTrigger Value="Vertical" Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}">
											<Setter Property="RenderTransform">
												<Setter.Value>
													<RotateTransform Angle="90" />
												</Setter.Value>
											</Setter>
										</DataTrigger>
										<Trigger Property="IsMouseOver" Value="true">
											<Setter Property="Fill" Value="Blue" />
										</Trigger>

									</Style.Triggers>
								</Style>
							</Path.Style>
						</Path>
						<ControlTemplate.Triggers>
							<Trigger Property="IsDragging" Value="true">
								<Setter TargetName="Path" Property="Fill" Value="LightBlue">
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>

					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>


